POSTGRES_DB=scenery_foundry
POSTGRES_USER=scenery
# Required (compose.yml uses ${POSTGRES_PASSWORD:?...}, no weak default) — set a real value
# before running `docker compose up` or `scripts/deploy.sh`; Compose fails fast if unset.
POSTGRES_PASSWORD=change-me
BACKEND_PORT=8080
FRONTEND_PORT=8081
POSTGRES_PORT=5432
WORKER_DB_PASSWORD=geometry-worker-local-dev

# --- Deploy profile only (scripts/deploy.sh, ADR-0008) — not needed for local `docker compose up` ---
# Real domain kept current by the duckdns sidecar, e.g. myproject.duckdns.org
DOMAIN=
# Subdomain part only (without .duckdns.org), registered at https://www.duckdns.org
DUCKDNS_SUBDOMAIN=
# Token from your DuckDNS account
DUCKDNS_TOKEN=
# Required (compose.yml uses ${ACME_EMAIL:?...}) — contact email Let's Encrypt uses for
# account/expiry notices; set a real value before deploying, Compose fails fast if unset.
ACME_EMAIL=you@example.com
